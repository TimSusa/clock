# Öffentliche OAuth-Client-IDs (KEINE Client-Secrets! Die gehören nie ins Frontend.)
# Kopieren nach .env.local und eigene IDs eintragen.
# iCal (.ics) funktioniert ohne jede Konfiguration.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID -> App registration -> Application (client) ID
# Redirect URI: http://127.0.0.1:5180/
VITE_OUTLOOK_CLIENT_ID=
