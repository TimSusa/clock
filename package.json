{
	"name": "clock",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Clock & calendar app (Svelte 5, strict TypeScript, Biome, Vitest)",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 5180",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 5181",
		"typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"verify": "npm run lint && npm run typecheck && npm run test && npm run build",
		"cap:sync": "npm run build && cap sync",
		"build:ios": "bash scripts/build-ios.sh",
		"build:android": "bash scripts/build-android.sh",
		"deploy:device": "bash scripts/deploy-device.sh",
		"go-live": "bash scripts/go-live.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.13",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^22.15.0",
		"jsdom": "^26.1.0",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.0",
		"vite": "^6.3.5",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.2",
		"@capacitor/cli": "^8.6.2",
		"@capacitor/core": "^8.6.2",
		"@capacitor/filesystem": "^8.1.0",
		"@capacitor/ios": "^8.6.2",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/preferences": "^8.0.1",
		"@ebarooni/capacitor-calendar": "^8.10.0"
	}
}
